; Engine configuration file.
config_version=5

[application]

config/name="Crowd Cannon"
config/description="Shoot, multiply and overrun the enemy base."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(1, 0.62, 0.2, 1)
boot_splash/image="res://assets/icons/adaptive_fg.png"
boot_splash/stretch_mode=0

[autoload]

Save="*res://scripts/save.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=936
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.android="gl_compatibility"
renderer/rendering_method.ios="mobile"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/vram_compression/import_etc2_astc=true
